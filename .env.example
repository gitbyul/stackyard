# Leave DATABASE_URL empty to use the embedded PGlite database in .data/ (local dev).
# On Vercel, connect a Neon database from the Marketplace; it sets DATABASE_URL for you.
DATABASE_URL=

# Random string, at least 32 chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional locally (defaults to http://localhost:3000). Vercel's URL is detected automatically.
BETTER_AUTH_URL=

# Secret Vercel Cron sends to /api/cron/reset-demo (daily demo reset). Leave empty to keep it off.
CRON_SECRET=
