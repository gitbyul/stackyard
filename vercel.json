{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "reset-demo": {
      "schedule": "0 3 * * *",
      "timezone": "Asia/Seoul",
      "path": "/api/cron/reset-demo",
      "requestMethod": "GET"
    },
    "purge-accounts": {
      "schedule": "0 4 */3 * *",
      "timezone": "Asia/Seoul",
      "path": "/api/cron/purge-accounts",
      "requestMethod": "GET"
    }
  }
}
